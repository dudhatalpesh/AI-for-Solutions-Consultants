# Copy to .env and change every value marked CHANGE_ME.
#   cp .env.example .env        (macOS/Linux/Git Bash)
#   Copy-Item .env.example .env (PowerShell)
# .env is git-ignored. Never commit real secrets, customer data or personal data.

# ---------- n8n ----------
# Pin a version you have tested. Check https://docs.n8n.io/release-notes/ for the current stable.
N8N_VERSION=2.44.6
# Long random string. Encrypts credentials stored in n8n. Losing it = losing access to saved credentials.
# Generate: openssl rand -hex 32   (or any 64-char random string)
N8N_ENCRYPTION_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING
GENERIC_TIMEZONE=UTC
TZ=UTC

# ---------- Postgres (n8n database + lab logging schema) ----------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=n8n

# ---------- Ollama (local models) ----------
# Models pulled by the ollama-init service on first start.
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------- Python labs ----------
N8N_BASE_URL=http://localhost:5678
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# ---------- Optional cloud models (leave blank to stay fully local) ----------
# Only set these if your organisation allows sending lab data to a cloud provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
