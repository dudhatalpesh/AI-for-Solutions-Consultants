{
  "name": "Lab 06 - Email Triage (classify + route + exception queue)",
  "nodes": [
    {
      "parameters": {
        "content": "## Lab 06 - Email triage\n`POST /webhook/lab06-triage {\"from\":\"customer@example.test\",\"subject\":\"...\",\"body\":\"...\"}`\n\n**Text Classifier** (Ollama, temp 0) picks one category; anything unclear goes to the **Other** output = exception queue for a human.\n\nProduction option: replace the Webhook with an **Email Trigger (IMAP)** node and a least-privilege mailbox credential, and replace the Set nodes with ticketing/CRM nodes.\n\nCredential: **Ollama (local)**.",
        "height": 320,
        "width": 420
      },
      "id": "0b1a0005-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-640, -300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lab06-triage",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0b1a0005-0000-4000-8000-000000000002",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-140, 100],
      "webhookId": "0b1a0005-0000-4000-8000-0000000000a1"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "e1", "name": "from", "value": "={{ $json.body.from || 'unknown' }}", "type": "string" },
            { "id": "e2", "name": "subject", "value": "={{ String($json.body.subject || '').slice(0, 300) }}", "type": "string" },
            { "id": "e3", "name": "email_body", "value": "={{ String($json.body.body || '').slice(0, 5000) }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "0b1a0005-0000-4000-8000-000000000003",
      "name": "Normalize Email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [60, 100]
    },
    {
      "parameters": {
        "inputText": "=Subject: {{ $json.subject }}\n\n{{ $json.email_body }}",
        "categories": {
          "categories": [
            { "category": "billing", "description": "Invoices, payments, refunds, pricing disputes, credit notes" },
            { "category": "technical_support", "description": "Product not working, errors, outages, how-to questions, login problems" },
            { "category": "sales_inquiry", "description": "New purchase interest, quotes, demos, upgrades, licence expansion" },
            { "category": "security_incident", "description": "Suspected breach, phishing report, compromised account, data exposure, vulnerability report" }
          ]
        },
        "options": { "fallback": "other" }
      },
      "id": "0b1a0005-0000-4000-8000-000000000004",
      "name": "Classify Email",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1,
      "position": [280, 100],
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "model": "llama3.2",
        "options": { "temperature": 0 }
      },
      "id": "0b1a0005-0000-4000-8000-000000000005",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [280, 320]
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "b1", "name": "category", "value": "billing", "type": "string" },
          { "id": "b2", "name": "queue", "value": "finance-ar", "type": "string" },
          { "id": "b3", "name": "priority", "value": "normal", "type": "string" }
        ] },
        "includeOtherFields": true,
        "options": {}
      },
